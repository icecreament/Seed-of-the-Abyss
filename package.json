{
  "name": "seed-of-the-abyss",
  "version": "0.1.0",
  "private": true,
  "description": "Seed of the Abyss - Top-down 2D action roguelike",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:regression": "node scripts/check-regressions.cjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-apk.mjs",
    "share:lan": "node scripts/share-lan.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "node scripts/build-desktop.mjs",
    "desktop:exe": "node scripts/build-desktop.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "33.2.1",
    "electron-builder": "24.13.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.seedabyss.game",
    "productName": "Seed of the Abyss",
    "copyright": "Copyright © Seed of the Abyss",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SeedOfTheAbyss-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "SeedOfTheAbyss-${version}-portable.exe"
    }
  }
}
