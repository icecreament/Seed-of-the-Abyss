{
  "name": "seed-of-the-abyss",
  "version": "0.1.0",
  "private": true,
  "description": "Seed of the Abyss - Top-down 2D action roguelike",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:regression": "node scripts/check-regressions.cjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-apk.mjs",
    "share:lan": "node scripts/share-lan.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "node scripts/build-desktop.mjs",
    "desktop:exe": "node scripts/build-desktop.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test:chapter": "node scripts/check-chapter-model.cjs",
    "test:chapter:browser": "node scripts/check-chapter-browser.cjs",
    "test:feel": "node scripts/check-feel-model.cjs",
    "test:feel:browser": "node scripts/check-feel-browser.cjs",
    "test:feel:natural": "node scripts/check-feel-natural.cjs",
    "test:chapter:natural": "node scripts/check-chapter-natural.cjs",
    "test:boss:browser": "node scripts/check-boss-feel-browser.cjs",
    "test:hud": "node scripts/check-hud-focus-model.cjs",
    "test:hud:browser": "node scripts/check-hud-focus-browser.cjs",
    "test:shade": "node scripts/check-shade-flow-model.cjs",
    "test:shade:browser": "node scripts/check-shade-flow-browser.cjs",
    "test:ambush:browser": "node scripts/check-ambush-browser.cjs",
    "test:awakening:browser": "node scripts/check-awakening-browser.cjs",
    "test:elite": "node scripts/check-elite-model.cjs",
    "test:elite:browser": "node scripts/check-elite-browser.cjs",
    "test:input": "node scripts/check-input-edge-model.cjs",
    "test:input:browser": "node scripts/check-input-edge-browser.cjs",
    "test:bloodbrand": "node scripts/check-bloodbrand-model.cjs",
    "test:bloodbrand:browser": "node scripts/check-bloodbrand-browser.cjs",
    "test:reaver": "node scripts/check-reaver-pursuit-model.cjs",
    "test:reaver:browser": "node scripts/check-reaver-pursuit-browser.cjs",
    "test:melee": "node scripts/check-melee-model.cjs",
    "test:melee:browser": "node scripts/check-melee-browser.cjs",
    "test:contact": "node scripts/check-contact-model.cjs",
    "test:contact:browser": "node scripts/check-contact-browser.cjs",
    "test:ranged": "node scripts/check-ranged-model.cjs",
    "test:ranged:browser": "node scripts/check-ranged-browser.cjs",
    "test:pursuit-cue": "node scripts/check-pursuit-cue-model.cjs",
    "test:pursuit-cue:browser": "node scripts/check-pursuit-cue-browser.cjs",
    "test:reprisal": "node scripts/check-warden-reprisal-model.cjs",
    "test:reprisal:browser": "node scripts/check-warden-reprisal-browser.cjs",
    "test:reprisal:natural": "node scripts/check-warden-reprisal-natural.cjs",
    "test:bloom": "node scripts/check-thorn-bloom-model.cjs",
    "test:bloom:browser": "node scripts/check-thorn-bloom-browser.cjs",
    "test:bloom:natural": "node scripts/check-thorn-bloom-natural.cjs",
    "test:guard-cue": "node scripts/check-guard-cue-model.cjs",
    "test:guard-cue:browser": "node scripts/check-guard-cue-browser.cjs",
    "test:guard-cue:natural": "node scripts/check-guard-cue-natural.cjs",
    "test:wound-focus": "node scripts/check-wound-focus-model.cjs",
    "test:wound-focus:browser": "node scripts/check-wound-focus-browser.cjs",
    "test:wound-focus:natural": "node scripts/check-wound-focus-natural.cjs",
    "test:shade-return": "node scripts/check-shade-return-model.cjs",
    "test:shade-return:browser": "node scripts/check-shade-return-browser.cjs",
    "test:shade-return:natural": "node scripts/check-shade-return-natural.cjs",
    "test:portraits:browser": "node scripts/check-portrait-presence-browser.cjs",
    "test:world-click": "node scripts/check-world-click-model.cjs",
    "test:world-click:browser": "node scripts/check-world-click-browser.cjs",
    "test:world-click:natural": "node scripts/check-world-click-natural.cjs",
    "test:combat-presence:browser": "node scripts/check-combat-presence-browser.cjs",
    "test:impact-audio": "node scripts/check-impact-audio-model.cjs",
    "test:impact-audio:browser": "node scripts/check-impact-audio-browser.cjs",
    "test:enemy-reaction": "node scripts/check-enemy-reaction-model.cjs",
    "test:enemy-reaction:browser": "node scripts/check-enemy-reaction-browser.cjs",
    "test:elite-presence": "node scripts/check-elite-presence-model.cjs",
    "test:elite-presence:browser": "node scripts/check-elite-presence-browser.cjs",
    "test:thorn-cast": "node scripts/check-thorn-cast-model.cjs",
    "test:thorn-cast:browser": "node scripts/check-thorn-cast-browser.cjs",
    "test:thorn-cue": "node scripts/check-thorn-cue-model.cjs",
    "test:thorn-cue:browser": "node scripts/check-thorn-cue-browser.cjs",
    "test:warden-release": "node scripts/check-warden-release-model.cjs",
    "test:warden-release:browser": "node scripts/check-warden-release-browser.cjs",
    "test:reaver-pounce": "node scripts/check-reaver-pounce-model.cjs",
    "test:reaver-pounce:browser": "node scripts/check-reaver-pounce-browser.cjs",
    "test:shade-action": "node scripts/check-shade-action-model.cjs",
    "test:shade-action:browser": "node scripts/check-shade-action-browser.cjs",
    "test:thorn-graft": "node scripts/check-thorn-graft-model.cjs",
    "test:thorn-graft:browser": "node scripts/check-thorn-graft-browser.cjs",
    "test:warden-rootline": "node scripts/check-warden-rootline-model.cjs",
    "test:warden-rootline:browser": "node scripts/check-warden-rootline-browser.cjs",
    "test:warden-rootline:natural": "node scripts/check-warden-rootline-natural.cjs",
    "test:reaver-relay": "node scripts/check-reaver-relay-hit-model.cjs",
    "test:reaver-relay:browser": "node scripts/check-reaver-relay-chain-browser.cjs",
    "test:reaver-relay:natural": "node scripts/check-reaver-relay-chain-natural.cjs",
    "test:reaver-relay:identity": "node scripts/check-reaver-relay-identity-model.cjs",
    "test:reaver-relay:identity:browser": "node scripts/check-reaver-relay-identity-browser.cjs",
    "test:reaver-relay:identity:natural": "node scripts/check-reaver-relay-identity-natural.cjs",
    "test:reaver-melee-debt": "node scripts/check-reaver-melee-debt-model.cjs",
    "test:reaver-melee-debt:browser": "node scripts/check-reaver-melee-debt-browser.cjs",
    "test:reaver-melee-debt:natural": "node scripts/check-reaver-melee-debt-natural.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "33.2.1",
    "electron-builder": "24.13.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.seedabyss.game",
    "productName": "Seed of the Abyss",
    "copyright": "Copyright 漏 Seed of the Abyss",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SeedOfTheAbyss-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "SeedOfTheAbyss-${version}-portable.exe"
    }
  }
}
