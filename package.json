{
  "name": "seed-of-the-abyss",
  "version": "0.1.0",
  "private": true,
  "description": "Seed of the Abyss - Top-down 2D action roguelike",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-apk.mjs",
    "share:lan": "node scripts/share-lan.mjs",
    "pack:web": "node scripts/pack-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
